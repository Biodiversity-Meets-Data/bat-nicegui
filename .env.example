# Application env variables.

# Required: replace with a secure random value in deployed environments.
SECRET_KEY=change-me

# Optional: keep the default for Docker Compose unless you need a custom DB path.
DATABASE_PATH=/app/data/bmd.db

# Required for Keycloak redirects: set to the externally reachable app URL.
LOCAL_API_BASE_URL=http://localhost

# Production Traefik settings. Required only with docker-compose.prod.yml.
DOMAIN=bmd.example.org
ACME_EMAIL=admin@example.org

# External workflow API
# Required for workflow submission: URL reachable from the app container.
WORKFLOW_API_URL=http://workflow-api:8002/api/v1/workflows

# Required for workflow submission if the workflow API requires authentication.
WORKFLOW_API_KEY=

# Required for workflow submission: must match the workflow API auth header.
WORKFLOW_API_AUTH_HEADER=Api-Key

# Optional: leave empty for raw API keys, or set to Bearer for Bearer tokens.
WORKFLOW_API_AUTH_SCHEME=

# Required for workflow callbacks: URL reachable from the workflow API container.
WORKFLOW_WEBHOOK_URL_TEMPLATE=http://bmd-bat-app:8080/api/workflows/webhook/{workflow_id}

# Optional: true validates workflows without executing them.
WORKFLOW_DRY_RUN=false

# Optional: true forces re-execution of an already submitted workflow.
WORKFLOW_FORCE=false

# Keycloak OpenID Connect
# Required for login.
KEYCLOAK_SERVER_URL=

# Required for login.
KEYCLOAK_REALM=

# Required for login.
KEYCLOAK_CLIENT_ID=

# Required for login.
KEYCLOAK_CLIENT_SECRET=
